# ==========================================================================
# dataweb - 환경설정 템플릿
#   이 파일을 복사해서 .env 로 저장한 뒤, 토큰 값을 채워 사용하세요.
#     Windows:  copy .env.example .env
# ==========================================================================

# Hugging Face 액세스 토큰 (https://huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=

# 임베딩 모델 (한국어 특화 권장: nlpai-lab/KURE-v1 | BAAI/bge-m3)
#   KURE-v1  = 한국어 검색 특화(bge-m3 파인튜닝) — 감사/행정 문맥 검색에 권장
#   bge-m3   = 다국어(한국어 강함), 범용
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# 백엔드 (local | hf_api)
#   local  = 이 PC에서 직접 실행. 토큰 불필요, 오프라인 가능(최초 1회 모델 다운로드).
#            sentence-transformers 설치 필요. 한국어 특화 모델은 이 쪽을 권장.
#   hf_api = Hugging Face 서버 호출. 토큰 필요, 로컬 설치 가벼움.
EMBEDDING_BACKEND=local

# hf_api 에서 토큰 임베딩을 한 벡터로 줄이는 방식 (cls | mean)
#   cls  = 첫 토큰([CLS]) — bge-m3/BERT 계열의 dense 표현. 기본·권장.
#   mean = 전체 토큰 평균 — 그렇게 학습된 모델(일부 e5/ST)일 때만.
POOLING=cls

# 하이브리드 검색: 최종점수 = HYBRID_ALPHA*임베딩 + (1-HYBRID_ALPHA)*키워드(BM25)
#   1.0 = 순수 벡터검색, 0.0 = 순수 키워드. 강한 한국어 모델에선 의미가 주도하도록 0.75 권장.
HYBRID_ALPHA=0.75

# 관련성 게이트(의미): 이 코사인 미만인 결과는 아예 숨긴다("겹치는 단어 몇 개"뿐인 무관 문서 제거).
#   보여줄지 말지는 순수하게 '의미 유사도'로 결정한다(키워드 겹침 아님).
#   KURE-v1/bge-m3 = 0.45~0.55 권장, multilingual-e5 = 0.80 근처.
MIN_RELEVANCE=0.5

# 청킹
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=16

# 경로
DATA_DIR=data
INDEX_DIR=index

# 모델별 프리픽스 (bge/KURE=빈값, e5=query:/passage:)
QUERY_PREFIX=
PASSAGE_PREFIX=

# 스캔 PDF OCR (선택)
ENABLE_OCR=0
OCR_LANG=kor+eng
