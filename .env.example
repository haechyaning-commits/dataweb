# ==========================================================================
# dataweb - 환경설정 템플릿
#   이 파일을 복사해서 .env 로 저장한 뒤, 토큰 값을 채워 사용하세요.
#     Windows:  copy .env.example .env
# ==========================================================================

# Hugging Face 액세스 토큰 (https://huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=

# 임베딩 모델 (BAAI/bge-m3 | nlpai-lab/KURE-v1 | intfloat/multilingual-e5-large)
EMBEDDING_MODEL=BAAI/bge-m3

# 백엔드 (hf_api | local)
EMBEDDING_BACKEND=hf_api

# hf_api 에서 토큰 임베딩을 한 벡터로 줄이는 방식 (cls | mean)
#   cls  = 첫 토큰([CLS]) — bge-m3/BERT 계열의 dense 표현. 기본·권장.
#   mean = 전체 토큰 평균 — 그렇게 학습된 모델(일부 e5/ST)일 때만.
POOLING=cls

# 하이브리드 검색: 최종점수 = HYBRID_ALPHA*임베딩 + (1-HYBRID_ALPHA)*키워드(BM25)
#   1.0 = 순수 벡터검색(옛 동작), 0.0 = 순수 키워드. 감사데이터엔 0.5~0.7 권장.
HYBRID_ALPHA=0.6

# 청킹
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=16

# 경로
DATA_DIR=data
INDEX_DIR=index

# 모델별 프리픽스 (bge/KURE=빈값, e5=query:/passage:)
QUERY_PREFIX=
PASSAGE_PREFIX=

# 스캔 PDF OCR (선택)
ENABLE_OCR=0
OCR_LANG=kor+eng
