# ==========================================================================
# dataweb - 환경설정 템플릿
#   이 파일을 복사해서 .env 로 저장한 뒤, 토큰 값을 채워 사용하세요.
#     Windows:  copy .env.example .env
# ==========================================================================

# --------------------------------------------------------------------------
# ⭐ 감사실 권장 프로필 (오프라인·무토큰·고품질 한국어)
#   아래 3줄이면 인터넷/토큰 없이 한국어 특화 1024차원 KURE-v1 로 동작합니다.
#   준비:  pip install -r requirements-local.txt   (최초 1회 모델 ~2GB 내려받음)
#   실행:  embedding.bat  →  search.bat "검색어"
# --------------------------------------------------------------------------
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_BACKEND=local
# GPU 자동 사용(없으면 CPU). 강제 지정 시: cuda | mps | cpu
# EMBEDDING_DEVICE=

# --------------------------------------------------------------------------
# 대안: Hugging Face Inference API (서버에서 임베딩, 로컬 GPU 불필요, 토큰 필요)
#   위 EMBEDDING_BACKEND 를 hf_api 로 바꾸고 아래 토큰을 채우세요.
#   토큰 발급: https://huggingface.co/settings/tokens (Read 권한)
# --------------------------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=
# EMBEDDING_MODEL 후보 (hf_api): BAAI/bge-m3 | nlpai-lab/KURE-v1 | intfloat/multilingual-e5-large

# 청킹
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=16

# 경로
DATA_DIR=data
INDEX_DIR=index

# 모델별 프리픽스 (bge/KURE=빈값, e5=query:/passage:)
QUERY_PREFIX=
PASSAGE_PREFIX=

# 스캔 PDF OCR (선택)
ENABLE_OCR=0
OCR_LANG=kor+eng
